---
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '../styles/global.css';
import { businessSchema } from '../data/schema';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Extra JSON-LD nodes for this page (Service, BreadcrumbList, FAQPage…). */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = 'Roofing, siding, and exterior contractor serving Maryland, Virginia, and DC since 2012. Licensed, insured, and ready for your free estimate.',
  ogImage = "https://pcdmv.com/og.jpg",
  schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [businessSchema, ...schema],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#1e3a6e" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Professional Construction LLC" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="shortcut icon" href="/logo.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <FloatingCTA />
  </body>
</html>
