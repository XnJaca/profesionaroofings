---
import { Image } from 'astro:assets';
import { services } from '../data/services';
import Icon from './Icon.astro';

const bySlug = (slug: string) => services.find((s) => s.slug === slug)!;
const exterior = ['asphalt-shingles', 'siding', 'gutters', 'tpo-roofing'].map(bySlug);
const more = ['kitchen-remodeling', 'bathroom-remodeling', 'interior-remodeling', 'decks-porches', 'additions', 'drywall'].map(bySlug);
---

<section class="services" id="services">
  <div class="container">
    <header class="head">
      <h2 class="section-title">Roofing, siding and gutters</h2>
      <p class="section-lead">
        Most of our work is on the outside of the house. The same crew handles remodels inside, too.
      </p>
    </header>

    <ul class="exterior" role="list">
      {
        exterior.map((service, i) => (
          <li class={`tile tile-${i}`}>
            <a href={`/services/${service.slug}/`}>
              <Image
                src={service.cover}
                alt={service.coverAlt}
                widths={i === 0 ? [600, 900, 1200, 1600] : [400, 600, 900]}
                sizes={i === 0 ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 40vw, 100vw'}
              />
              <div class="tile-body">
                <h3>{service.shortName}</h3>
                <p>{service.tagline}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="more">
      <h3 class="more-title">Inside the house</h3>
      <ul class="more-list" role="list">
        {
          more.map((service) => (
            <li>
              <a href={`/services/${service.slug}/`}>
                <Image src={service.cover} alt="" widths={[160, 240]} sizes="80px" class="thumb" />
                <span>
                  <strong>{service.shortName}</strong>
                  <small>{service.tagline}</small>
                </span>
                <Icon name="arrow-right" size={18} class="arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    padding: 6rem 0;
    background: var(--color-bg);
  }

  .head {
    margin-bottom: 2.5rem;
  }

  .exterior {
    list-style: none;
    display: grid;
    grid-template-columns: 7fr 5fr;
    grid-template-rows: repeat(3, minmax(190px, auto));
    gap: 1rem;
  }

  .tile-0 {
    grid-row: span 3;
  }

  .tile a {
    position: relative;
    display: block;
    height: 100%;
    min-height: 190px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: #fff;
    background: var(--color-primary-dark);
  }

  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile a:hover :global(img) {
    transform: scale(1.04);
  }

  /* A short scrim only behind the caption, so the photo stays clean. */
  .tile-body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.5rem 1.4rem 1.2rem;
    background: linear-gradient(180deg, transparent, rgba(10, 20, 40, 0.78));
  }

  .tile h3 {
    color: #fff;
    font-size: 1.2rem;
    margin-bottom: 0.2rem;
  }

  .tile-0 h3 {
    font-size: 1.6rem;
  }

  .tile p {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.88);
  }

  .more {
    margin-top: 3.5rem;
  }

  .more-title {
    font-size: 1.2rem;
    margin-bottom: 1rem;
  }

  .more-list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .more-list a {
    display: grid;
    grid-template-columns: 64px 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
  }

  .more-list :global(.thumb) {
    width: 64px;
    height: 48px;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .more-list span {
    display: grid;
    gap: 0.1rem;
  }

  .more-list strong {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--color-text);
  }

  .more-list small {
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .more-list :global(.arrow) {
    color: var(--color-text-muted);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .more-list a:hover :global(.arrow) {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  .more-list a:hover strong {
    color: var(--color-primary);
  }

  @media (max-width: 900px) {
    .services {
      padding: 4rem 0;
    }
    .exterior {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }
    .tile-0 {
      grid-row: auto;
      grid-column: 1 / -1;
    }
    .tile-0 a {
      aspect-ratio: 4 / 3;
    }
    .more-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .exterior {
      grid-template-columns: 1fr;
    }
    .tile a {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
</style>
