---
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<header class="nav" id="site-header">
  <div class="container nav-inner">
    <a href="/" class="logo" aria-label={`${site.name} home`}>
      <img src="/logo-mark.png" alt="" class="logo-mark" width="91" height="40" decoding="async" />
      <span class="logo-text">
        <span class="logo-name">Professional Construction</span>
        <span class="logo-sub">Roofing, siding &amp; remodeling</span>
      </span>
    </a>

    <nav class="nav-links" id="primary-nav" aria-label="Primary">
      <a href="/">Home</a>
      <a href="/#services">Services</a>
      <a href="/#about">About</a>
      <a href="/#projects">Projects</a>
      <a href="/#contact">Contact</a>
      <a href={`tel:${site.phoneRaw}`} class="nav-phone">
        <Icon name="phone" size={18} />
        {site.phone}
      </a>
      <a href="/#contact" class="btn btn-accent nav-cta">Free estimate</a>
    </nav>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .nav {
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 68px;
    padding: 0.6rem 0;
    gap: 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .logo-mark {
    height: 34px;
    width: auto;
    display: block;
  }

  .logo-text {
    display: grid;
    line-height: 1.1;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }

  .logo-sub {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .nav-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-primary) !important;
    font-weight: 600 !important;
  }

  .nav-phone::after {
    display: none;
  }

  @media (max-width: 1100px) and (min-width: 901px) {
    .nav-links a:not(.nav-cta):not(.nav-phone) {
      display: none;
    }
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links a {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-text-soft);
    position: relative;
    transition: color 0.2s;
  }

  .nav-links a:not(.nav-cta):hover {
    color: var(--color-primary);
  }

  .nav-links a:not(.nav-cta)::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    height: 2px;
    width: 0;
    background: var(--color-accent);
    transition: width 0.25s ease;
  }

  .nav-links a:not(.nav-cta):hover::after {
    width: 100%;
  }

  .nav-links a.nav-cta {
    padding: 0.6rem 1.15rem;
    font-size: 0.85rem;
    color: #fff;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 6px;
  }

  .nav-toggle span {
    width: 26px;
    height: 2px;
    background: var(--color-primary);
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: #fff;
      padding: 1rem 1.25rem 1.25rem;
      border-bottom: 1px solid var(--color-border);
      gap: 1rem;
      transform: translateY(-10px);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .nav-links.is-open {
      transform: translateY(0);
      opacity: 1;
      pointer-events: auto;
    }

    .nav-links a {
      padding: 0.4rem 0;
    }

    .nav-cta {
      align-self: flex-start;
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(2) {
      opacity: 0;
    }

    .nav-toggle[aria-expanded='true'] span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
