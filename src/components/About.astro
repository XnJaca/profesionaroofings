---
import { Image } from 'astro:assets';
import crewPhoto from '../assets/hero/crew-on-roof.jpg';
import { site, contacts } from '../data/site';
import Icon from './Icon.astro';

const owner = contacts.find((c) => c.role === 'Owner')!;
const manager = contacts.find((c) => c.role === 'Manager')!;

const promises = [
  { icon: 'receipt', title: 'Written estimates', text: 'Free, within 24 hours. What we quote is what you pay.' },
  { icon: 'seal-check', title: '10-year workmanship warranty', text: 'If something we installed fails, we come back and make it right.' },
  { icon: 'umbrella', title: 'Insurance claims', text: 'We document storm damage and work with your adjuster.' },
];
---

<section class="about" id="about">
  <div class="container">
    <div class="photo">
      <Image
        src={crewPhoto}
        alt="Our crew finishing a new gray architectural shingle roof on a suburban home"
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="(min-width: 1240px) 1240px, 92vw"
        class="photo-img"
      />
    </div>

    <div class="grid">
      <div class="copy">
        <h2 class="section-title">Who you’ll be working with</h2>
        <p>
          {owner.name} started Professional Construction in {site.founded}. Since then his team has
          been replacing roofs, siding and gutters on homes across Maryland, DC and Virginia.
        </p>
        <p>
          We are a small company. When you call, you talk to {owner.name.split(' ')[0]} or to our
          manager, {manager.name}, not a call center.
        </p>
      </div>

      <ul class="promises" role="list">
        {
          promises.map((p) => (
            <li>
              <Icon name={p.icon} size={26} class="icon" />
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--color-bg);
    padding: 6rem 0;
  }

  .photo {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 16 / 8;
    background: var(--color-bg-soft);
    margin-bottom: 3.5rem;
  }

  .photo :global(.photo-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 72%;
    display: block;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 4rem;
    align-items: start;
  }

  .copy p {
    color: var(--color-text-soft);
    font-size: 1.08rem;
    line-height: 1.7;
    max-width: 58ch;
    margin-bottom: 1rem;
  }

  .promises {
    list-style: none;
    display: grid;
    gap: 1.6rem;
    padding-top: 0.4rem;
  }

  .promises li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }

  .promises :global(.icon) {
    color: var(--color-accent);
    margin-top: 0.1rem;
  }

  .promises h3 {
    font-size: 1.05rem;
    margin-bottom: 0.2rem;
  }

  .promises p {
    color: var(--color-text-soft);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .about {
      padding: 4rem 0;
    }
    .photo {
      aspect-ratio: 4 / 3;
      margin-bottom: 2.5rem;
    }
    .photo :global(.photo-img) {
      object-position: 40% 80%;
    }
    .grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
