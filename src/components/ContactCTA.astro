---
import { site, contacts } from '../data/site';
import Icon from './Icon.astro';
---

<section class="cta" id="contact">
  <div class="container">
    <div class="grid">
      <div class="copy">
        <h2>Tell us about your project</h2>
        <p>
          We reply within 24 hours with a time to come out and measure. Estimates are free and
          insurance claims are welcome.
        </p>

        <ul class="contact-list">
          {
            contacts.map((c) => (
              <li>
                <Icon name="phone" size={20} />
                <a href={`tel:${c.phoneRaw}`}>
                  {c.phone}
                  <em>{c.name}, {c.role}</em>
                </a>
              </li>
            ))
          }
          <li>
            <Icon name="envelope-simple" size={20} />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <Icon name="map-pin" size={20} />
            <span>Based in {site.city}. Serving Maryland, DC and Virginia.</span>
          </li>
        </ul>
      </div>

      <form class="form" name="estimate" method="POST" action="/api/contact" data-form>
        <h3>Request a free estimate</h3>
        <div class="row">
          <label>
            <span>Name</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>Phone</span>
            <input type="tel" name="phone" required autocomplete="tel" />
          </label>
        </div>
        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          <span>Service interested in</span>
          <select name="service" required>
            <option value="">Select a service…</option>
            <option>Asphalt Shingles Roofing</option>
            <option>TPO Roofing (Commercial/Residential)</option>
            <option>James Hardie Siding</option>
            <option>Drywall Work</option>
            <option>Gutters &amp; Gutter Guards</option>
            <option>Kitchen Remodeling</option>
            <option>Bathroom Remodeling</option>
            <option>Interior Remodeling</option>
            <option>Decks &amp; Porches</option>
            <option>Home Addition / New Construction</option>
            <option>Other / Not sure</option>
          </select>
        </label>
        <label>
          <span>Project details</span>
          <textarea name="message" rows="4" placeholder="Tell us a bit about your project, timeline, and address…"></textarea>
        </label>

        <label class="hp" aria-hidden="true">
          <span>Website</span>
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>

        <button type="submit" class="btn btn-accent submit">
          Send Request →
        </button>
        <p class="form-status" data-status role="status" aria-live="polite"></p>
        <p class="disclaimer">
          By submitting, you agree to be contacted at the info above. No spam, ever.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-primary-dark);
    color: #fff;
    padding: 6rem 0;
    position: relative;
    overflow: hidden;
  }

  .cta::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 45%;
    background: linear-gradient(135deg, transparent, rgba(96, 165, 250, 0.16));
    pointer-events: none;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: 4rem;
    align-items: start;
    position: relative;
  }

  .copy .eyebrow {
    color: var(--color-accent-soft);
  }

  .copy h2 {
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    color: #fff;
    margin-bottom: 1rem;
  }

  .copy p {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: 2.2rem;
    max-width: 480px;
  }

  .contact-list {
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: rgba(255, 255, 255, 0.88);
  }

  .contact-list em {
    font-style: normal;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.86rem;
    margin-left: 0.35rem;
  }

  .contact-list :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--color-accent-soft);
    flex-shrink: 0;
  }

  .contact-list a:hover {
    color: var(--color-accent-soft);
  }

  .form {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(10px);
    padding: 2.4rem 2.2rem;
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--color-accent);
  }

  .form h3 {
    color: #fff;
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  label {
    display: block;
    margin-bottom: 0.9rem;
  }

  label span {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 0.4rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s, background 0.2s;
  }

  input::placeholder,
  textarea::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: rgba(255, 255, 255, 0.12);
  }

  select option {
    background: var(--color-primary-dark);
    color: #fff;
  }

  textarea {
    resize: vertical;
    min-height: 100px;
  }

  .submit {
    width: 100%;
    margin-top: 0.4rem;
    padding: 1rem 1.6rem;
  }

  .disclaimer {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.55);
    margin-top: 0.9rem;
    text-align: center;
  }

  .hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    text-align: center;
    min-height: 1.2em;
  }

  .form-status.is-success {
    color: var(--color-accent-soft);
  }

  .form-status.is-error {
    color: #fca5a5;
  }

  .form.is-sent .submit,
  .form.is-sent label:not(.hp) {
    display: none;
  }

  .form.is-sent .form-status {
    font-size: 1.05rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-form]');
  if (form) {
    // The 3D exterior studio hands over the chosen layer and colors.
    window.addEventListener('studio:quote', (e) => {
      const { service, message } = (e as CustomEvent<{ service: string; message: string }>).detail;
      const select = form.querySelector<HTMLSelectElement>('select[name=service]');
      const textarea = form.querySelector<HTMLTextAreaElement>('textarea[name=message]');
      if (select && [...select.options].some((o) => o.value === service)) select.value = service;
      if (textarea && !textarea.value.trim()) textarea.value = message;
    });

    const status = form.querySelector<HTMLElement>('[data-status]');
    const submit = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const originalText = submit?.textContent ?? 'Send Request';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status || !submit) return;

      status.className = 'form-status';
      status.textContent = '';
      submit.disabled = true;
      submit.textContent = 'Sending…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          form.classList.add('is-sent');
          status.classList.add('is-success');
          status.textContent =
            "Thanks! We received your request and will reach out within 24 hours.";
        } else {
          throw new Error(data.error || 'Send failed');
        }
      } catch (err) {
        submit.disabled = false;
        submit.textContent = originalText;
        status.classList.add('is-error');
        status.textContent =
          'Something went wrong. Please call or message us on WhatsApp.';
      }
    });
  }
</script>
