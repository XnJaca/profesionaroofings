---
import { site } from '../data/site';
import Icon from './Icon.astro';

const items = [
  { icon: 'certificate', label: 'Maryland license', value: `#${site.licenses[1].number}` },
  { icon: 'certificate', label: 'DC license', value: `#${site.licenses[0].number}` },
  { icon: 'certificate', label: 'Plumbing license', value: `#${site.licenses[2].number}` },
  { icon: 'shield-check', label: 'Bonded and insured', value: `Since ${site.founded}` },
];
---

<section class="license-strip" aria-label="Licenses and insurance">
  <ul class="container items" role="list">
    {
      items.map((item) => (
        <li>
          <Icon name={item.icon} size={22} class="icon" />
          <span>
            <small>{item.label}</small>
            <strong>{item.value}</strong>
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .license-strip {
    background: var(--color-primary-dark);
    color: #fff;
  }

  .items {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.25rem 1.5rem;
  }

  li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.14);
  }

  li:first-child {
    padding-left: 0;
  }

  li :global(.icon) {
    color: var(--color-accent-soft);
    flex-shrink: 0;
  }

  span {
    display: grid;
    line-height: 1.25;
  }

  small {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.7);
  }

  strong {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  @media (max-width: 900px) {
    .items {
      grid-template-columns: 1fr 1fr;
    }
    li {
      padding: 1rem 0.75rem;
    }
    li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }
    li:nth-child(n + 3) {
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
  }
</style>
