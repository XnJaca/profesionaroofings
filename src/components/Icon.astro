---
// Phosphor icons (regular weight), inlined so they inherit currentColor.
const icons = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/regular/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const raw = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);
const svg = raw.replace(
  '<svg ',
  `<svg width="${size}" height="${size}" fill="currentColor" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''} `,
);
---

<Fragment set:html={svg} />
