---
import { site } from '../data/site';
import { services } from '../data/services';
import Icon from './Icon.astro';
---

<footer class="footer">
  <div class="container">
    <div class="grid">
      <div class="brand">
        <div class="brand-name">
          <img src="/logo-mark-light.png" alt="" width="73" height="32" />
          {site.name}
        </div>
        <p>
          Roofing, siding, gutters, and remodeling contractor serving the DMV area
          since {site.founded}.
        </p>
        <ul class="socials">
          <li>
            <a href={site.social.facebook} aria-label="Facebook" target="_blank" rel="noopener">
              <Icon name="facebook-logo" size={20} />
            </a>
          </li>
          <li>
            <a href={site.social.instagram} aria-label="Instagram" target="_blank" rel="noopener">
              <Icon name="instagram-logo" size={20} />
            </a>
          </li>
          <li>
            <a href={site.whatsapp} aria-label="WhatsApp" target="_blank" rel="noopener">
              <Icon name="whatsapp-logo" size={20} />
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h5>Services</h5>
        <ul class="link-list">
          {
            services.slice(0, 6).map((s) => (
              <li>
                <a href={`/services/${s.slug}/`}>{s.shortName}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h5>More</h5>
        <ul class="link-list">
          {
            services.slice(6).map((s) => (
              <li>
                <a href={`/services/${s.slug}/`}>{s.shortName}</a>
              </li>
            ))
          }
          <li><a href="/#projects">All Projects</a></li>
        </ul>
      </div>

      <div>
        <h5>Get in touch</h5>
        <ul class="link-list">
          <li>
            <a href={`tel:${site.phoneRaw}`}>{site.phone}</a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>{site.city}</li>
          <li>{site.hours}</li>
          <li><a href="/privacy/">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="licenses-block" aria-label="Licenses">
      <span class="licenses-title">Licensed, bonded and insured</span>
      <ul class="licenses-list">
        {
          site.licenses.map((l) => (
            <li>
              <span class="lic-label">
                {l.jurisdiction ? `${l.jurisdiction} ${l.label}` : l.label}
              </span>
              <span class="lic-num">{l.number}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bottom">
      <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
      <span>Serving Maryland, DC and Virginia</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-dark);
    color: rgba(255, 255, 255, 0.7);
    padding: 5rem 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .brand-name img {
    height: 28px;
    width: auto;
  }

  .brand p {
    font-size: 0.94rem;
    color: rgba(255, 255, 255, 0.68);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  h5 {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    margin-bottom: 1.1rem;
  }

  .link-list {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .link-list li,
  .link-list a {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s;
  }

  .link-list a:hover {
    color: var(--color-accent-soft);
  }

  .link-list .muted {
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .socials {
    list-style: none;
    display: flex;
    gap: 0.7rem;
  }

  .socials a {
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.72);
    transition: all 0.2s;
  }

  .socials a:hover {
    background: var(--color-accent);
    color: #fff;
    border-color: var(--color-accent);
  }

  .socials :global(svg) {
    width: 17px;
    height: 17px;
  }

  .licenses-block {
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    padding: 1.5rem 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .licenses-title {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-accent-soft);
  }

  .licenses-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 0;
  }

  .licenses-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
  }

  .licenses-list .lic-label {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.55);
  }

  .licenses-list .lic-num {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.02em;
  }

  .bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    padding-top: 1.8rem;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.8rem;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  @media (max-width: 540px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
