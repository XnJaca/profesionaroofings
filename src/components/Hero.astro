---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Icon from './Icon.astro';
import heroHouse from '../assets/hero/home-stone-estate.jpg';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 class="hero-title">Roofing and siding contractor in Lanham, MD</h1>
      <p class="hero-lead">
        New roofs, James Hardie siding and seamless gutters across Prince George’s County and
        DC since {site.founded}.
      </p>
      <div class="hero-cta">
        <a href="/#contact" class="btn btn-accent">
          Free estimate
          <Icon name="arrow-right" size={18} />
        </a>
        <a href={`tel:${site.phoneRaw}`} class="btn btn-ghost">
          <Icon name="phone" size={18} />
          {site.phone}
        </a>
      </div>
    </div>

    <div class="hero-media">
      <Image
        src={heroHouse}
        alt="Two-story stone and siding home with a new architectural shingle roof and wraparound porch"
        class="hero-img"
        loading="eager"
        fetchpriority="high"
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="(min-width: 1024px) 58vw, 100vw"
        quality={72}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-bg);
    padding: 3rem 0 3.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 3.5rem;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4vw, 3.3rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
    text-wrap: balance;
  }

  .hero-lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-soft);
    max-width: 34ch;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-cta .btn:active {
    transform: translateY(1px);
  }

  .hero-media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-soft);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 60%;
    display: block;
  }

  @media (max-width: 1023px) {
    .hero {
      padding: 1.25rem 0 2.5rem;
    }
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .hero-media {
      order: -1;
      aspect-ratio: 16 / 10;
    }
    .hero-lead {
      max-width: 52ch;
    }
  }

  @media (max-width: 480px) {
    .hero-cta .btn {
      flex: 1 1 100%;
    }
  }
</style>
